{
	"name": "pocket-chest-backend",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"pretest": "node -e \"const fs=require('fs');fs.existsSync('wrangler.jsonc')||fs.copyFileSync('wrangler.jsonc.template','wrangler.jsonc')\"",
		"test": "vitest run",
		"cf-typegen": "wrangler types",
		"generate-totp": "node scripts/generate-totp.js",
		"lint": "eslint . --ext .ts,.js",
		"lint:fix": "eslint . --ext .ts,.js --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.22.0",
		"@eslint/js": "^9.33.0",
		"@typescript-eslint/eslint-plugin": "^8.39.1",
		"@typescript-eslint/parser": "^8.39.1",
		"eslint": "^9.33.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.4",
		"prettier": "^3.6.2",
		"typescript": "^5.5.2",
		"vitest": "~4.1.11",
		"wrangler": "~4.143.1"
	},
	"overrides": {
		"sharp": "~0.35.5",
		"undici": "~7.29.1"
	}
}
